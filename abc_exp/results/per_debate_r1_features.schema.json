{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LiXin97/DebateLedger/blob/main/abc_exp/results/per_debate_r1_features.schema.json",
  "title": "Per-Debate R1 Derived Feature Matrix",
  "description": "Open schema for transcript-free R1 localization and replay diagnostics. Rows contain derived labels and features only; full transcript text remains in the gated trace tier.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "row_id",
    "model_id",
    "benchmark",
    "question_id",
    "initial_majority_correct",
    "final_majority_correct",
    "collapsed",
    "corrected",
    "r1_majority_changed",
    "r1_n_flipped_from_initial",
    "r1_agree_frac",
    "release_tier"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "per_debate_r1_features.v1"},
    "row_id": {"type": "string", "description": "Stable anonymous row identifier."},
    "model_id": {"type": "string", "description": "Release-safe model or family identifier."},
    "benchmark": {"type": "string"},
    "question_id": {"type": "string", "description": "Public benchmark id or salted hash if required by license."},
    "split_id": {"type": ["string", "null"], "description": "Held-out, fold, or replay split identifier when applicable."},
    "initial_majority_correct": {"type": "boolean"},
    "final_majority_correct": {"type": "boolean"},
    "collapsed": {"type": "boolean"},
    "corrected": {"type": "boolean"},
    "collapse_onset_round": {"type": ["integer", "null"], "minimum": 1},
    "init_unanimous": {"type": ["boolean", "null"]},
    "init_agree_frac": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "r1_majority_changed": {"type": "boolean"},
    "r1_n_flipped_from_initial": {"type": "integer", "minimum": 0},
    "r1_agree_frac": {"type": "number", "minimum": 0, "maximum": 1},
    "r2_majority_changed": {"type": ["boolean", "null"]},
    "r2_agree_frac": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "r3_majority_changed": {"type": ["boolean", "null"]},
    "r3_agree_frac": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "parser_flags": {"type": "array", "items": {"type": "string"}},
    "release_tier": {"type": "string", "enum": ["open_derived", "gated_trace_derived"]},
    "provenance": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean", "null"]}}
  }
}
