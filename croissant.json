  "@type": "sc:Dataset",
  "name": "Debate Collapse/Correction Evaluation Artifact",
  "description": "Validated Croissant/RAI metadata for the collapse/correction evaluation protocol bundle used in a homogeneous-panel LLM debate audit.",
  "conformsTo": "http://mlcommons.org/croissant/1.0",
  "citeAs": "Xin Li, Mengbing Liu, and Chau Yuen. Measuring Collapse and Correction in Homogeneous-Panel LLM Debate. NeurIPS 2026 Evaluations and Datasets Track. DebateLedger artifact version 1.0.0.",
  "dateCreated": "2026-05-02",
  "datePublished": "2026-09-28",
  "inLanguage": "en",
  "keywords": [
    "multi-agent debate",
    "evaluation",
    "collapse",
    "correction",
    "MMLU-Pro",
    "responsible AI"
  ],
  "license": "https://creativecommons.org/licenses/by/4.0/",
  "rai:dataAnnotationProtocol": "No human labeling. Collapse/correction labels are deterministic functions of parsed MCQ answers and answer keys.",
  "rai:dataBiases": "Primary evidence is MMLU-Pro; homogeneous same-model three-agent scaffold; realized G=7 family cohort with Qwen-heavy model rows.",
  "rai:dataCollection": "Public benchmark MCQ questions were processed by LLM agents under fixed probe and debate prompts. No human-subjects or personal data were collected.",
  "rai:dataCollectionMissingData": "Closed-API snapshot metadata are partial for older sealed lanes; full transcripts and the R1 feature matrix are gated for dual-use reasons.",
  "rai:dataCollectionRawData": "Upstream public MCQ benchmark questions are not owned by this artifact; derived aggregate tables and trace summaries are released subject to upstream benchmark terms.",
  "rai:dataCollectionType": "machine-generated traces from public benchmark questions",
  "rai:dataLimitations": "Not a benchmark-general law; not a calibrated per-question oracle; not a deployable controller; gated tier needed for convince-wrong templates and full transcripts.",
  "rai:dataPreprocessingProtocol": "Rule-based MCQ answer extraction; majority voting after filtering unparsed answers; alphabetic tie-breaking; deterministic collapse/correction/onset labels.",
  "rai:dataReleaseMaintenancePlan": "Versioned public release (alpha-tot-v1.0): open data on Hugging Face, code on GitHub, and a gated Hugging Face dataset for full transcripts and convince-wrong templates. Corrections and provider or parser changes are released as new minor versions.",
  "rai:dataSocialImpact": "Helps audit debate interventions that may reduce collapses while discarding corrections; gated release mitigates misuse as a misleading-answer corpus.",
  "rai:dataUseCases": "Zero-API recomputation of aggregate tables; applying the transition-table and signed-utility protocol to new model-scaffold pairs; documenting gated release boundaries; public artifact hosting on Hugging Face with code on GitHub.",
  "rai:hasSyntheticData": true,
  "rai:machineAnnotationTools": "Rule-based MCQ answer parser included in the artifact; no LLM judge step is used.",
  "rai:personalSensitiveInformation": "none",
  "url": "https://huggingface.co/datasets/XINLI1997/DebateLedger",
  "version": "1.0.0",
